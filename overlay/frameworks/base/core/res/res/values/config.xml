<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Refresh rate configs (Samsung 120Hz Super AMOLED) -->
    <integer name="config_defaultRefreshRate">60</integer>
    <integer name="config_defaultPeakRefreshRate">120</integer>
    <integer-array name="config_fpsRequirement">
        <item>60</item>
        <item>120</item>
    </integer-array>

    <!-- Display cutout / Hole-punch camera (Centered top, 1080x2340) -->
    <string translatable="false" name="config_mainBuiltInDisplayCutout">
        M 505,0 H 575 V 110 H 505 Z
    </string>
    <string translatable="false" name="config_mainBuiltInDisplayCutoutRectApproximation">
        M 505,0 H 575 V 110 H 505 Z
    </string>
    <dimen name="rounded_corner_radius">36dp</dimen>
    <dimen name="rounded_corner_radius_top">36dp</dimen>
    <dimen name="rounded_corner_radius_bottom">36dp</dimen>

    <!-- Double tap to wake (DT2W) -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- Under-Display Fingerprint (UDFPS / Optical FOD) -->
    <bool name="config_supportsInDisplayFingerprint">true</bool>
    <string translatable="false" name="config_udfps_vendor_sensor_type">optical</string>

    <!-- Brightness & Color -->
    <integer name="config_screenBrightnessSettingMinimum">1</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <integer name="config_screenBrightnessSettingDefault">102</integer>
    <bool name="config_hasColorMatrix">true</bool>
    <bool name="config_automatic_brightness_available">true</bool>

