#
# Samsung HyPer (hypervisor) service (vendor.samsung.hardware.hyper-service)
#
# Bring-up policy: the prebuilt binary has no seclabel in its stock init .rc, so
# the domain is reached through the executable label below. The domain is
# permissive on purpose - it logs denials instead of blocking boot. Once the
# device boots, run `adb shell dmesg | grep avc` and replace this with real
# allow rules.
#

type hal_samsung_hyper_default, domain;
type hal_samsung_hyper_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_samsung_hyper_default)

binder_use(hal_samsung_hyper_default)

allow hal_samsung_hyper_default vendor_file:file rx_file_perms;

permissive hal_samsung_hyper_default;
