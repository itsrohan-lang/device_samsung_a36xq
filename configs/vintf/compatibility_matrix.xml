<?xml version="1.0" encoding="utf-8"?>
<!--
    Device compatibility matrix for the Samsung Galaxy A36 5G (a36xq).

    Copied from the stock firmware (vendor/etc/vintf/compatibility_matrix.xml),
    which the blob list does not carry. It tells the framework which HALs the
    vendor side expects the system side to provide.
-->
<compatibility-matrix version="8.0" type="device">
    <hal format="aidl" optional="true">
        <name>android.frameworks.sensorservice</name>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.qti.hardware.sigma_miracast_aidl</name>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.qti.qccsyshal_aidl</name>
        <interface>
            <name>IQccsyshal</name>
            <instance>default</instance>
        </interface>
    </hal>
    <system-sdk>
        <version>35</version>
    </system-sdk>
</compatibility-matrix>
