# Properties for the Samsung Galaxy A36 5G (a36xq) - system partition.
#
# Only hardware/feature configuration that the framework actually consumes
# lives here. Build identity, OneUI, Samsung security framework and GMS
# properties are deliberately absent - the build system owns those.
#

# Audio
ro.audio.spatializer_enabled=true
tunnel.audio.encode=true

# Bluetooth
ro.bluetooth.library_name=libbluetooth_qti.so

# GNSS
persist.vendor.overlay.izat.optin=rro

# Health
ro.charger.enable_suspend=1

# Media
media.aac_51_output_enabled=true
media.extractor.sec.pcm-32bit=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-qcp=true
media.stagefright.thumbnail.prefer_hw_codecs=true

# NFC
ro.nfc.port=I2C

# Radio
ril.subscription.types=NV,RUIM
rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so
telephony.lteOnCdmaDevice=1

# Wi-Fi
ro.wifi.channels=

# Wi-Fi Display
persist.debug.wfd.enable=1
persist.sys.wfd.virtual=0

# IMS / VoLTE / VoWiFi / VoNR
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.radio.calls.on.ims=1
persist.radio.jbims=1
persist.radio.vrte_logic=2
persist.radio.data_ltd_sys_ind=1
persist.radio.data_con_rprt=1

# Telephony
persist.vendor.radio.atfwd.start=true

# Miscellaneous
config.disable_rtt=true
persist.fuse_sdcard=true
persist.mm.enable.prefetch=true
persist.rmnet.data.enable=true
persist.vendor.data.mode=concurrent
vendor.mm.enable.qcom_parser=16777215
